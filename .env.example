# Copy to .env. Do not commit .env or send secrets to chat.
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DEMO_ENABLED=false
DATA_DIR=./data
# Google Cloud > Google Auth Platform > Clients > Web application
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Match Google Auth Platform > Audience: internal or external.
GOOGLE_AUTH_AUDIENCE=internal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=student.tdtu.edu.vn,tdtu.edu.vn
ALLOWED_HOSTED_DOMAINS=student.tdtu.edu.vn,tdtu.edu.vn
# Comma-separated verified Google emails; overrides the domain-based role.
# External: only these emails are Lecturers. Empty value means no exceptions.
# Internal: these emails must still belong to an allowed TDTU Workspace domain.
LECTURER_EMAILS=523h0025@student.tdtu.edu.vn
